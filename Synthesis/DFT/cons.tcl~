# =======================================================================================
# File       : cons.tcl
# Author     : Youssef Ahmed
# Description: Generic, reusable constraint file for Synopsys Design Compiler.
#              Supports parameterized configuration for clocks, I/O timing,
#              driving cells, loads, operating conditions, and wireload models.
# Usage      : Override variables from the main synthesis script before sourcing.
# =======================================================================================


# ==============================================================
# =============== Section 0 : DC Variables / Safety ============
# ==============================================================

# Prevent unwanted assign statements and ensure clean constant handling
# -all              : Apply to all nets.
# -buffer_constants : Insert buffers where constants are directly connected.
# -feedthroughs     : Avoid creating direct assigns between ports.
set_fix_multiple_port_nets -all -buffer_constants -feedthroughs


# ==============================================================
# ============= Section 1 : Clock Definition ===================
# ==============================================================

# ---------- Default Clock Parameters (override if needed) ----------
if {![info exists CLK_NAME]}       { set CLK_NAME      "clk" }
if {![info exists CLK_PER]}        { set CLK_PER        100   }   ;# ns
if {![info exists CLK_SETUP_SKEW]} { set CLK_SETUP_SKEW 0.2   }   ;# ns
if {![info exists CLK_HOLD_SKEW]}  { set CLK_HOLD_SKEW  0.1   }   ;# ns
if {![info exists CLK_LAT]}        { set CLK_LAT        0     }
if {![info exists CLK_RISE]}       { set CLK_RISE       0.05  }
if {![info exists CLK_FALL]}       { set CLK_FALL       0.05  }

# ---------- Master Clock Definition ----------
# -waveform "0 [expr $CLK_PER/2]" [get_ports $CLK_NAME] if it is ignored -> it is assumed 50% duty
create_clock -name $CLK_NAME -period $CLK_PER -waveform "0 [expr $CLK_PER/2]" [get_ports $CLK_NAME]

# ---------- Clock Properties ----------
set_clock_uncertainty -setup $CLK_SETUP_SKEW [get_clocks $CLK_NAME]
set_clock_uncertainty -hold  $CLK_HOLD_SKEW  [get_clocks $CLK_NAME]
set_clock_transition  -rise  $CLK_RISE       [get_clocks $CLK_NAME]
set_clock_transition  -fall  $CLK_FALL       [get_clocks $CLK_NAME]
set_clock_latency            $CLK_LAT        [get_clocks $CLK_NAME]

# Protect clock and reset networks from optimization
set_dont_touch_network {clk arst_n}


